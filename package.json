{
  "name": "code-station",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.3",
  "bin": {
    "codestation": "./bin/codestation-mcp.mjs",
    "codestation-mcp": "./bin/codestation-mcp.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "generate:mcp-docs": "node scripts/generate-mcp-docs.mjs",
    "build": "node scripts/copy-pdfjs-assets.mjs && node scripts/generate-third-party-notices.mjs && next build && node scripts/generate-offline-manifest.mjs",
    "build:mcp": "esbuild mcp/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=bin/codestation-mcp.mjs && chmod +x bin/codestation-mcp.mjs && mkdir -p packages/codestation-mcp/bin && cp bin/codestation-mcp.mjs packages/codestation-mcp/bin/ && chmod +x packages/codestation-mcp/bin/codestation-mcp.mjs",
    "publish:mcp": "npm run build:mcp && cd packages/codestation-mcp && npm publish --access public",
    "mcp": "node ./bin/codestation-mcp.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:verify": "node scripts/verify-cloudflare-preview.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "audit:ui": "node scripts/audit-ui.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@types/jsbarcode": "^3.12.3",
    "@types/qrcode": "^1.5.6",
    "alasql": "^4.22.1",
    "entities": "^8.1.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.80.0",
    "next": "^15.5.0",
    "node-sql-parser": "5.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.1.0",
    "react-calendar": "^6.0.1",
    "react-clock": "^6.0.0",
    "react-dom": "^19.1.0",
    "saxes": "^6.0.0",
    "smol-toml": "^1.9.0",
    "sql-formatter": "15.10.0",
    "tr46": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.1.0",
    "@types/tr46": "^5.0.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.27",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.168.0"
  }
}
