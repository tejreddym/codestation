{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codestation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "codestation.in",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "SITE_INDEXING": "index",
    "NEXT_PUBLIC_ADS_ENABLED": "true",
    "NEXT_PUBLIC_ADS_SOCIAL_BAR_ENABLED": "true",
    "NEXT_PUBLIC_ADS_NATIVE_ENABLED": "true",
    "NEXT_PUBLIC_ADS_BANNER_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "LICENSE_KV",
      "id": "8f45dc8ed96b4ccfaa8c90b810ba53ca",
      "preview_id": "9746b80c30ed44118531786a1fe6d972"
    }
  ],
  "observability": {
    "enabled": true
  }
}
