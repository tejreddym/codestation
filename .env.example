# Code Station Next environment variables
# Optional verified public origin used for canonical URLs and XML indexing.
# Must be an HTTPS origin with no credentials, query, fragment, or path.
NEXT_PUBLIC_SITE_URL=https://codestation.in
# Local/default builds keep indexing disabled. The approved codestation.in
# production deployment sets SITE_INDEXING=index in both Cloudflare build and
# runtime variables; it also supplies the verified NEXT_PUBLIC_SITE_URL.
SITE_INDEXING=
# Ads are disabled by default. Set the master and each desired format switch
# exactly to "true" only in a production deployment.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_SOCIAL_BAR_ENABLED=false
NEXT_PUBLIC_ADS_NATIVE_ENABLED=false
NEXT_PUBLIC_ADS_BANNER_ENABLED=false

# Razorpay Standard Checkout credentials
# Secret must remain private on server; public Key ID is exposed to browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
